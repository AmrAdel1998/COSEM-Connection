      <widget class="QWidget" name="rightPane">
       <property name="maximumWidth"><number>380</number></property>
       <property name="minimumWidth"><number>200</number></property>
       <layout class="QVBoxLayout" name="rightVLayout">
        <item>
         <widget class="QLabel" name="logoLabel">
          <property name="minimumHeight"><number>120</number></property>
          <property name="maximumHeight"><number>160</number></property>
          <property name="alignment">
           <set>Qt::AlignCenter</set>
          </property>
